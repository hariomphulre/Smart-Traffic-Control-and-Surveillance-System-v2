# Copy to .env: cp .env.example .env

# Public URL (browser) — nginx entry point
PUBLIC_ORIGIN=http://localhost
PUBLIC_WS_ORIGIN=ws://localhost
NGINX_PORT=80

# Postgres (Docker internal + host port 5432)
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic_db

# ML simulation
ML_DEFAULT_MODEL=new_car4_with_helmet.pt
ML_DEFAULT_RESOLUTION=500x300
# Limit concurrent YOLO workers to avoid OOM (exit 137)
ML_MAX_PARTITIONS=1
ML_PARTITION_STAGGER_SEC=6
