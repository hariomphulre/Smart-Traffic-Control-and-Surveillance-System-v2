# Docker Compose (postgres service):
# DATABASE_URL=postgresql://traffic:traffic@localhost:5432/traffic_db
# DATABASE_SSL=false
DATABASE_URL=postgresql://user:password@localhost:5432/traffic_db

# Campus networks often block port 53 to 8.8.8.8 (EREFUSED) — leave DNS_SERVERS commented.
# The app uses DNS-over-HTTPS automatically. Manual override if needed:
# Only if DNS fails. Refresh with: npm run resolve:neon (stale IP causes "Connection terminated")
# NEON_HOST_IP=13.251.17.193
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Set to true for Neon/cloud; false for local Postgres without SSL
# DATABASE_SSL=false

# When DB is unreachable in development, API returns demo data automatically.
# Set USE_MOCK_DATA=false to disable; set USE_MOCK_DATA=true to force demo data.
# USE_MOCK_DATA=false

# Optional — leave empty to disable Redis caching
REDIS_URL=
# REDIS_ENABLED=true

# Browser origin(s) allowed to call this API (CORS). Comma-separated for multiple URLs.
FRONTEND_URL=http://localhost:3000
# Extra origins (e.g. Vercel preview): https://app.vercel.app,https://app-git-main-xxx.vercel.app
# CORS_ALLOWED_ORIGINS=
# Allow any *.vercel.app Origin (good for previews; tighten for production)
# CORS_ALLOW_VERCEL=false

PORT=3001
NODE_ENV=development

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
