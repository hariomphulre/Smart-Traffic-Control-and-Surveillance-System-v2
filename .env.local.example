PUBLIC_ORIGIN=http://localhost
PUBLIC_WS_ORIGIN=ws://localhost
NGINX_PORT=80
NGINX_SSL_PORT=443

POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic_db

ML_DEFAULT_MODEL=new_car4_with_helmet.pt
ML_DEFAULT_RESOLUTION=500x300
ML_MAX_PARTITIONS=4
ML_PARTITION_STAGGER_SEC=0
DISABLE_ML_STATS_LOOP=true
ML_SERVICE_URL=http://ml-service:8000

NEXT_PUBLIC_BACKEND_URL=http://localhost
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost/ws/analytics
NEXT_PUBLIC_EMERGENCY_SOCKET_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://backend:3001

# Cloudflare Turnstile (site key — also used by /api/turnstile/site-key in Docker)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
