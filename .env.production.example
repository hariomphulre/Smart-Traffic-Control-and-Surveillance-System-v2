# VPS / Docker Compose deployment template
# Copy this file to .env on the VPS.
# Replace placeholders with your public domain.

# Browser-facing URLs (the frontend bundle reads these at build time)
PUBLIC_ORIGIN=http://your-vps-domain
PUBLIC_WS_ORIGIN=ws://your-vps-domain
PUBLIC_EMERGENCY_SOCKET_URL=http://your-vps-domain/emergency

# Public port for nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Local Postgres container
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic_db

# ML service runtime
ML_DEFAULT_MODEL=new_car4_with_helmet.pt
ML_DEFAULT_RESOLUTION=500x300
ML_MAX_PARTITIONS=4
ML_PARTITION_STAGGER_SEC=6
DISABLE_ML_STATS_LOOP=true

# Frontend build args
NEXT_PUBLIC_BACKEND_URL=http://your-vps-domain
NEXT_PUBLIC_ML_SERVICE_URL=http://your-vps-domain
NEXT_PUBLIC_WS_URL=ws://your-vps-domain/ws/analytics
NEXT_PUBLIC_EMERGENCY_SOCKET_URL=http://your-vps-domain/emergency

# Domain used by nginx template (no protocol)
PUBLIC_DOMAIN=your-vps-domain
