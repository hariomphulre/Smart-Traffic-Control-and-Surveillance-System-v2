NODE_ENV=production
DOCKER=false
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.neon.tech/traffic_db
DATABASE_SSL=true
REDIS_URL=redis://:token@your-upstash-host:port
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.vercel.app
USE_MOCK_DATA=false
ML_SERVICE_URL=https://smart-traffic-ml-service.onrender.com
TRAFFIC_JSON_PATH=/ml_service/traffic_signal_simulation/traffic.json

NEXT_PUBLIC_BACKEND_URL=https://your-backend.vercel.app
NEXT_PUBLIC_ML_SERVICE_URL=https://smart-traffic-ml-service.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-backend.vercel.app/ws/analytics
BACKEND_INTERNAL_URL=https://your-backend.vercel.app
NODE_ENV=production

# Go to: Render Dashboard → ML Service → Settings → Environment
# Add these:

ML_DEFAULT_MODEL=new_car4_with_helmet.pt
ML_DEFAULT_RESOLUTION=500x300
ML_MAX_PARTITIONS=4
ML_PARTITION_STAGGER_SEC=6
REDIS_URL=redis://:token@your-upstash-host:port
DISABLE_ML_STATS_LOOP=true


DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.neon.tech/traffic_db

# ============ UPSTASH REDIS ============
# From Upstash Console → Your Database → Details
# Format: redis://[user]:[password]@[host]:[port]

REDIS_URL=redis://:AxxxB@clever-dragon-xxxxx.upstash.io:38765
UPSTASH_REDIS_REST_URL=https://clever-dragon-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxx


BACKEND_API_URL=https://your-backend.vercel.app
ML_SERVICE_URL=https://smart-traffic-ml-service.onrender.com
FRONTEND_APP_URL=https://your-frontend.vercel.app
