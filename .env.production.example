# Copy this file to .env on the VPS.

PUBLIC_ORIGIN=https://signal-x.hariomphulre.tech
PUBLIC_WS_ORIGIN=wss://signal-x.hariomphulre.tech
PUBLIC_EMERGENCY_SOCKET_URL=https://signal-x.hariomphulre.tech/emergency

POSTGRES_USER=traffic
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=traffic_db

ML_DEFAULT_MODEL=new_car4_with_helmet.pt
ML_DEFAULT_RESOLUTION=500x300
ML_MAX_PARTITIONS=4
ML_PARTITION_STAGGER_SEC=0
DISABLE_ML_STATS_LOOP=true

NEXT_PUBLIC_BACKEND_URL=https://signal-x.hariomphulre.tech
NEXT_PUBLIC_ML_SERVICE_URL=https://signal-x.hariomphulre.tech
NEXT_PUBLIC_WS_URL=wss://signal-x.hariomphulre.tech/ws/analytics
NEXT_PUBLIC_EMERGENCY_SOCKET_URL=https://signal-x.hariomphulre.tech/emergency
NEXT_PUBLIC_EMERGENCY_SOCKET_PATH=/emergency/socket.io
NEXT_PUBLIC_EMERGENCY_SOCKET_TRANSPORTS=polling,websocket

# Cloudflare Turnstile (site key is public; secret stays on the backend only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

PUBLIC_DOMAIN=signal-x.hariomphulre.tech